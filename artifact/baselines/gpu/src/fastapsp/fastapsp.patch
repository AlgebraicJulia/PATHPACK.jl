diff -ruN orig/fap/fap_timers.h patched/fap/fap_timers.h
--- orig/fap/fap_timers.h	1969-12-31 19:00:00.000000000 -0500
+++ patched/fap/fap_timers.h	2026-10-03 19:29:43.982450716 -0400
@@ -0,0 +1,14 @@
+// [gpubase instrumentation] wall-clock phase accumulators (timing only, no algorithmic change).
+#pragma once
+#include <chrono>
+namespace fap {
+struct FapTimers {
+  double read = 0, metis = 0, pre = 0, solve = 0;
+  double sssp = 0, build = 0, floyd = 0, mat1 = 0, minplus = 0, decode = 0;
+  long long bdy_total = 0, max_sub = 0;
+};
+inline FapTimers& fap_timers() { static FapTimers t; return t; }
+inline double fap_now() {
+  return std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+}  // namespace fap
